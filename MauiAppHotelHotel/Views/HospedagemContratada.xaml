<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotelHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource White}">
             
     
    <VerticalStackLayout VerticalOptions="CenterAndExpand">

        <Label Text="{Binding Quarto.Descricao}" 
               TextColor="{StaticResource Magenta}"
               FontFamily="OpenSans-Semibold"
               FontSize="50"
               HorizontalTextAlignment="Center" />

        <Frame Margin="10">
            <StackLayout Orientation="Horizontal" >                
                <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                    
                    <Label Text="Adultos: " />
                    <Label Text="{Binding QntAdultos}" 
                           TextColor="{StaticResource Magenta}" />
                </HorizontalStackLayout>


                <HorizontalStackLayout HorizontalOptions="CenterAndExpand">      
                    <Label Text="Crianças: " />
                    <Label Text="{Binding QntCriancas}"
                           TextColor="{StaticResource Magenta}" />
                    
                </HorizontalStackLayout>
                
            </StackLayout>
        </Frame>

        <Frame Margin="10" >
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto">
                
                <Label Grid.Row="0" Grid.Column="0" Text="Check-In: " />
                <Label Grid.Row="0" Grid.Column="1" Text="Check-Out: " />
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia: " />

                <Label Grid.Row="1" 
                       Grid.Column="0" Text="{Binding DataCheckIn, StringFormat='{}{0:dd/MM/yyyy}'}"
                       TextColor="{StaticResource Magenta}"/>
                
                <Label Grid.Row="1" Grid.Column="1" 
                       Text="{Binding DataCheckOut, StringFormat='{}{0:dd/MM/yyyy}'}"
                       TextColor="{StaticResource Magenta}"/>
                
                <Label Grid.Row="1" Grid.Column="2" 
                       Text="{Binding Estadia}"
                       TextColor="{StaticResource Magenta}"/>

            </Grid>            
        </Frame>

        <Frame Margin="10">
            <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                <Label Text="Valor Total: " />
                <Label Text="{Binding ValorTotal, StringFormat='{}{0:c}'}"
                       TextColor="{StaticResource Magenta}"/>                
            </HorizontalStackLayout>          
            
        </Frame>

        <Button Text="Voltar" 
                HorizontalOptions="Center"
                Clicked="Button_Clicked"
                TextColor="{StaticResource Magenta}"
                FontFamily="OpenSans-Semibold"/>





    </VerticalStackLayout>
    
</ContentPage>