<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotelHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource White}">
             
     
    <VerticalStackLayout VerticalOptions="CenterAndExpand">

        <Label Text="Suíte Super Luxo" 
               TextColor="{StaticResource Magenta}"
               FontFamily="OpenSans-Semibold"
               FontSize="50"
               HorizontalTextAlignment="Center" />

        <Frame Margin="10">
            <HorizontalStackLayout>
                
                <HorizontalStackLayout>
                    <Label Text="Adultos: " />
                    <Label Text="2" 
                           TextColor="{StaticResource Magenta}" />
                </HorizontalStackLayout>
                

                <HorizontalStackLayout>
                    <Label Text="Crianças: " />
                    <Label Text="1"
                           TextColor="{StaticResource Magenta}" />
                    
                </HorizontalStackLayout>
                
            </HorizontalStackLayout>
        </Frame>

        <Frame Margin="10" >
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto">
                
                <Label Grid.Row="0" Grid.Column="0" Text="Check-In: " />
                <Label Grid.Row="0" Grid.Column="1" Text="Check-Out: " />
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia: " />

                <Label Grid.Row="1" Grid.Column="0" Text="27/05/2024" />
                <Label Grid.Row="1" Grid.Column="1" Text="30/05/2024" />
                <Label Grid.Row="1" Grid.Column="2" Text="3" />

            </Grid>            
        </Frame>

        <Frame Margin="10">
            <HorizontalStackLayout>
                <Label Text="Valor Total: " />
                <Label Text="R$1350" />                
            </HorizontalStackLayout>          
            
        </Frame>

        <Button Text="Voltar" 
                HorizontalOptions="Center"
                Clicked="Button_Clicked"
                TextColor="{StaticResource Magenta}"
                FontFamily="OpenSans-Semibold"/>





    </VerticalStackLayout>
    
</ContentPage>